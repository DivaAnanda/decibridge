# Copy to .env and adjust for your local environment.
# .env is gitignored — never commit secrets.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=decibridge.settings

# ── Database (PostgreSQL via Laragon or Docker Compose) ───────────────────
# Laragon default: postgres://postgres:@127.0.0.1:5432/decibridge
# Docker Compose:  postgres://decibridge:decibridge@db:5432/decibridge
DATABASE_URL=postgres://postgres:@127.0.0.1:5432/decibridge

# ── Redis / Celery (Memurai on Windows or Docker Compose) ─────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── CORS (React dev server) ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ── Storage paths (for uploaded XLSX, generated DOCX/PDF, archive) ────────
MEDIA_ROOT=./media
ARCHIVE_ROOT=./media/archive
